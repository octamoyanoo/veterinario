<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<VBox prefHeight="580.0" prefWidth="480.0" spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sira.controller.AnimalFichaController">
   <stylesheets>
      <URL value="@../css/styles.css" />
   </stylesheets>
   <children>
      <!-- Header Superior de la Modal -->
      <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="window-header-ficha">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="6.0">
               <children>
                  <Circle fill="#ff5f56" onMouseClicked="#handleCerrar" radius="5.5" stroke="TRANSPARENT" strokeType="INSIDE" style="-fx-cursor: hand;" />
                  <Circle fill="#ffbd2e" radius="5.5" stroke="TRANSPARENT" strokeType="INSIDE" />
                  <Circle fill="#27c93f" radius="5.5" stroke="TRANSPARENT" strokeType="INSIDE" />
               </children>
            </HBox>
            <Label fx:id="lblTituloVentana" styleClass="window-title" text="Ficha animal   modal" />
         </children>
         <padding>
            <Insets bottom="8.0" left="12.0" right="12.0" top="8.0" />
         </padding>
      </HBox>

      <!-- Subtítulo / Metadata del FXML -->
      <VBox spacing="2.0">
         <children>
            <Label fx:id="lblHeaderTag" styleClass="modal-header-tag" text="AnimalFichaView.fxml" />
            <Label fx:id="lblHeaderDesc" styleClass="modal-header-desc" text="Recibe: Animal + callback" />
         </children>
         <padding>
            <Insets left="18.0" right="18.0" top="2.0" />
         </padding>
      </VBox>

      <!-- Mensaje general de error (visible si faltan datos críticos) -->
      <VBox>
         <children>
            <Label fx:id="lblMensajeError" managed="false" styleClass="banner-error" text="¡Atención! Falta ingresar datos críticos obligatorios." visible="false" />
         </children>
         <padding>
            <Insets left="18.0" right="18.0" />
         </padding>
      </VBox>

      <!-- Campos de Formulario -->
      <VBox spacing="8.0">
         <children>
            <VBox spacing="2.0">
               <children>
                  <Label styleClass="form-label" text="Nombre (* dato crítico)" />
                  <TextField fx:id="txtNombre" promptText="Nombre del animal" />
                  <Label fx:id="lblErrorNombre" managed="false" styleClass="label-error" text="* Falta ingresar el Nombre (dato crítico obligatorio)" visible="false" />
               </children>
            </VBox>
            <VBox spacing="2.0">
               <children>
                  <Label styleClass="form-label" text="Especie (* dato crítico)" />
                  <TextField fx:id="txtEspecie" promptText="Perro, Gato, etc." />
                  <Label fx:id="lblErrorEspecie" managed="false" styleClass="label-error" text="* Falta ingresar la Especie (dato crítico obligatorio)" visible="false" />
               </children>
            </VBox>
            <HBox spacing="10.0">
               <children>
                  <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="form-label" text="Estado" />
                        <TextField fx:id="txtEstado" promptText="EN_REFUGIO, EN_TRATAMIENTO, ADOPTADO..." text="EN_REFUGIO" />
                     </children>
                  </VBox>
                  <VBox prefWidth="140.0" spacing="2.0">
                     <children>
                        <Label styleClass="form-label" text="Sexo" />
                        <TextField fx:id="txtSexo" promptText="hembra / macho" text="hembra" />
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
         <padding>
            <Insets left="18.0" right="18.0" />
         </padding>
      </VBox>

      <!-- Sección Historial Clínico -->
      <VBox fx:id="seccionHistorial" spacing="6.0" VBox.vgrow="ALWAYS">
         <children>
            <Label styleClass="card-title" text="Historial clínico (lista enlazada)" />
            <TableView fx:id="tablaHistorial" prefHeight="130.0" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colFecha" prefWidth="180.0" text="Fecha" />
                <TableColumn fx:id="colTipo" prefWidth="240.0" text="Tipo" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
         <padding>
            <Insets left="18.0" right="18.0" />
         </padding>
      </VBox>

      <!-- Botones de Acción Inferiores -->
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#handleGuardar" styleClass="btn-success" text="Guardar" />
            <Button fx:id="btnDeshacer" mnemonicParsing="false" onAction="#handleDeshacer" styleClass="btn-warning" text="Deshacer" />
            <Button fx:id="btnCerrar" mnemonicParsing="false" onAction="#handleCerrar" styleClass="btn-slate" text="Cerrar" />
            <Button fx:id="btnNuevaAdopcion" mnemonicParsing="false" onAction="#handleAbrirAdopcion" styleClass="btn-dark" text="Nueva adopción" />
         </children>
         <padding>
            <Insets bottom="16.0" left="18.0" right="18.0" top="6.0" />
         </padding>
      </HBox>
   </children>
</VBox>
