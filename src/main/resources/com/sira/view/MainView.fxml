<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<VBox prefHeight="530.0" prefWidth="760.0" spacing="0.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sira.controller.MainController">
   <stylesheets>
      <URL value="@../css/styles.css" />
   </stylesheets>
   <children>
      <!-- Barra superior / Header simulado -->
      <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="window-header">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="6.0">
               <children>
                  <Circle fill="#ff5f56" onMouseClicked="#handleSalir" radius="5.5" stroke="TRANSPARENT" strokeType="INSIDE" style="-fx-cursor: hand;" />
                  <Circle fill="#ffbd2e" radius="5.5" stroke="TRANSPARENT" strokeType="INSIDE" />
                  <Circle fill="#27c93f" radius="5.5" stroke="TRANSPARENT" strokeType="INSIDE" />
               </children>
            </HBox>
            <Label styleClass="window-title" text="SIRA — Principal" />
            <Label styleClass="window-badge" text="MainView.fxml" />
         </children>
         <padding>
            <Insets bottom="7.0" left="12.0" right="12.0" top="7.0" />
         </padding>
      </HBox>

      <!-- Barra de Menús -->
      <MenuBar>
        <menus>
          <Menu mnemonicParsing="false" text="Archivo">
            <items>
              <MenuItem mnemonicParsing="false" onAction="#handleSalir" text="Salir" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Animales">
            <items>
              <MenuItem mnemonicParsing="false" onAction="#handleRefrescar" text="Listar" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Personas">
            <items>
              <MenuItem mnemonicParsing="false" text="Gestionar" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Adopciones">
            <items>
              <MenuItem mnemonicParsing="false" onAction="#handleNuevaAdopcion" text="Nueva adopción" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Veterinaria">
            <items>
              <MenuItem mnemonicParsing="false" onAction="#handleAbrirFicha" text="Historial clínico" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Donaciones">
            <items>
              <MenuItem mnemonicParsing="false" text="Registrar" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Alertas">
            <items>
              <MenuItem mnemonicParsing="false" text="Ver alertas" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Asistente">
            <items>
              <MenuItem mnemonicParsing="false" text="Ayuda" />
            </items>
          </Menu>
        </menus>
      </MenuBar>

      <!-- Barra de Herramientas (Botones de acción) -->
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Button fx:id="btnNuevo" mnemonicParsing="false" onAction="#handleNuevo" styleClass="btn-primary" text="Nuevo" />
            <Button fx:id="btnEditar" mnemonicParsing="false" onAction="#handleEditar" styleClass="btn-secondary" text="Editar" />
            <Button fx:id="btnRefrescar" mnemonicParsing="false" onAction="#handleRefrescar" styleClass="btn-secondary" text="Refrescar" />
         </children>
         <padding>
            <Insets bottom="8.0" left="14.0" right="14.0" top="10.0" />
         </padding>
      </HBox>

      <!-- Campo de Búsqueda -->
      <HBox alignment="CENTER_LEFT">
         <children>
            <TextField fx:id="txtBuscar" prefWidth="220.0" promptText="Buscar animal..." styleClass="search-field" />
         </children>
         <padding>
            <Insets bottom="10.0" left="14.0" right="14.0" top="2.0" />
         </padding>
      </HBox>

      <!-- Área de Contenido Principal -->
      <HBox spacing="16.0" VBox.vgrow="ALWAYS">
         <children>
            <!-- Tabla de Animales -->
            <TableView fx:id="tablaAnimales" prefHeight="310.0" prefWidth="430.0" HBox.hgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colNombre" prefWidth="130.0" text="Nombre" />
                <TableColumn fx:id="colEspecie" prefWidth="120.0" text="Especie" />
                <TableColumn fx:id="colEstado" prefWidth="170.0" text="Estado" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>

            <!-- Card de Resumen del seleccionado -->
            <VBox maxWidth="280.0" minWidth="260.0" prefWidth="270.0" spacing="10.0" styleClass="card-panel">
               <children>
                  <Label fx:id="lblResumenTitulo" styleClass="card-title" text="Resumen del seleccionado" />
                  <Label fx:id="lblResumenSub" styleClass="card-subtitle" text="Luna · Perro · hembra" />
                  <Label fx:id="lblResumenFecha" styleClass="card-date" text="Ingreso 12/08/2026" />
                  <Label fx:id="lblResumenEstado" styleClass="card-status-green" text="Estado EN_REFUGIO" />
                  
                  <Pane VBox.vgrow="ALWAYS" />
                  
                  <HBox alignment="CENTER" spacing="10.0">
                     <children>
                        <Button fx:id="btnAbrirFicha" mnemonicParsing="false" onAction="#handleAbrirFicha" styleClass="btn-primary" text="Abrir ficha" />
                        <Button fx:id="btnNuevaAdopcion" mnemonicParsing="false" onAction="#handleNuevaAdopcion" styleClass="btn-dark" text="Nueva adopción" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
         <padding>
            <Insets bottom="12.0" left="14.0" right="14.0" top="4.0" />
         </padding>
      </HBox>

      <!-- Barra de Estado Inferior -->
      <HBox alignment="CENTER_LEFT" spacing="6.0" styleClass="status-bar">
         <children>
            <Label styleClass="status-text" text="BOTTOM" />
            <Label styleClass="status-highlight" text="API: conectado" />
            <Label styleClass="status-text" text="|" />
            <Label styleClass="status-highlight" text="operador" />
         </children>
      </HBox>
   </children>
</VBox>
